              "raw": "{{base_url}}/auth/sign-up",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "sign-up"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Volunteer\",\n  \"email\": \"{{volunteer_email}}\",\n  \"password\": \"{{volunteer_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test(\"response has success true\", function () { pm.expect(json.success).to.eql(true); });",
                  "pm.collectionVariables.set(\"volunteer_token\", json.data.access_token);",
