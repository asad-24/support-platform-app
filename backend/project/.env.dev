DEBUG=true

# Server
# Use 0.0.0.0 so Android/iOS devices on the same Wi-Fi can reach the API.
SERVER_PROTOCOL=http
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_PUBLIC_URL=http://192.168.100.23:8000
CORS_ORIGINS=*

# Database
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=expressjs_api_server
