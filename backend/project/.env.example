SERVER_PROTOCOL=http
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,https://schoolsupportatlas.com,https://www.schoolsupportatlas.com,https://admin.schoolsupportatlas.com

JWT_SECRET=change-this-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@schoolsupportatlas.local
ADMIN_PASSWORD=admin123

# Use Brevo SMTP in real environments. Tests may set EMAIL_TRANSPORT=fake.
EMAIL_TRANSPORT=smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=info@schoolsupportatlas.com
BREVO_SMTP_KEY=brevo-smtp-key
BREVO_FROM="School Support Atlas <info@schoolsupportatlas.com>"
ADMIN_NOTIFICATION_EMAIL=contact@schoolsupportatlas.com
