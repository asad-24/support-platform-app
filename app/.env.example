APP_ENV=local
API_BASE_URL=http://localhost:3000

# Android emulator cannot reach your computer with localhost.
# Use this value in .env.local.android when Express runs on your computer.
ANDROID_EMULATOR_API_BASE_URL=http://10.0.2.2:3000

# Physical devices must use your computer LAN IP while both are on same Wi-Fi.
PHYSICAL_DEVICE_API_BASE_URL=http://192.168.1.20:3000

# Production example. Replace with your real HTTPS API domain.
PRODUCTION_API_BASE_URL=https://api.your-domain.com
